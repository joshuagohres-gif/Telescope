# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telescope

# AstroDB Feature Flags
ASTRO_KB_ENABLED=true
ASTRO_DESIGN_KB_ENABLED=true
ASTRO_OPS_ENABLED=true
ASTRO_CALIB_ENABLED=true
ASTRO_TARGETS_ENABLED=true
ASTRO_PLANQA_ENABLED=true
ASTRO_SKYMAP_ENABLED=true

# CAD Feature (Experimental)
GENERATIVE_CAD_ENABLED=false

# Sky Image (for static sky backdrop)
# URL to an equirectangular sky image. If not provided, falls back to computer-generated stars.
# Example sources: Stellarium Web API, Aladin Sky Atlas, or custom uploaded images
# VITE_SKY_IMAGE_URL=https://example.com/path/to/sky-image.png

# Server
PORT=5000
NODE_ENV=development

# OpenAI (for NLP commands)
OPENAI_API_KEY=your_api_key_here
